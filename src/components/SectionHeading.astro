---
// Cabeçalho de seção: o prompt de terminal é o que aparece (como no wireframe);
// o título real da seção fica no heading para leitores de tela.
interface Props {
  id: string;
  command: string;
  title: string;
  level?: 'h1' | 'h2';
}

const { id, command, title, level = 'h2' } = Astro.props;
const Tag = level;
---

<Tag id={id} class="prompt">
  <span aria-hidden="true"><span class="ps">$</span>{command}</span>
  <span class="sr-only">{title}</span>
</Tag>
