---
import { profile } from '../lib/content';
import { hasCv, cvHref } from '../lib/site';

const [user, host] = profile.handle.split('@');
const links = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#experiencia', label: 'Experiência' },
  { href: '#stack', label: 'Stack' },
  { href: '#contato', label: 'Contato' },
];
---

<header class="band band-tight border-b border-border">
  <nav
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3"
    aria-label="Navegação principal"
  >
    <a href="#inicio" class="font-mono text-md font-semibold text-text no-underline">
      {user}@{host}<span class="font-normal text-accent" aria-hidden="true">:~$</span>
    </a>
    <ul class="m-0 flex list-none flex-wrap items-center gap-x-4 gap-y-2 p-0 text-sm">
      {
        links.map((link, i) => (
          <li class="flex items-center gap-x-4">
            <a href={link.href} class="text-text-muted no-underline hover:text-text hover:underline">
              {link.label}
            </a>
            {i < links.length - 1 && (
              <span class="text-border" aria-hidden="true">
                ·
              </span>
            )}
          </li>
        ))
      }
      {
        hasCv && (
          <li>
            <a href={cvHref} class="btn btn-small" download>
              cv.pdf
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>
