---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects } from '../lib/content';
import { Image } from 'astro:assets';
import { hasCv, cvHref, photo } from '../lib/site';

const title = `${profile.name} · Desenvolvedor Backend`;
const description = `${profile.name}, desenvolvedor backend em ${profile.location}. ${profile.pitch}`;
const year = new Date().getFullYear();
const linkedinLabel = 'LinkedIn';
const githubLabel = 'GitHub';

const section = 'band border-t border-border';
---

<Layout title={title} description={description}>
  <a
    href="#conteudo"
    class="sr-only bg-accent px-4 py-2 text-on-accent no-underline focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10"
  >
    Pular para o conteúdo
  </a>

  <div class="page">
    <Nav />

    <main id="conteudo">
      {/* HERO */}
      <section id="inicio" aria-labelledby="hero-title" class="band grid gap-4">
        <p class="prompt" aria-hidden="true"><span class="ps">$</span>whoami</p>

        <div class:list={['hero-grid', { 'has-photo': photo }]}>
          <div class="grid min-w-0 gap-4">
            <div>
              <h1 id="hero-title" class="text-hero font-semibold tracking-[-0.01em] text-text">
                {profile.name}
              </h1>
              <p class="mt-2 font-mono text-md text-text-muted">{profile.headline}</p>
            </div>

            <p class="max-w-pitch text-md">{profile.pitch}</p>

            <div class="flex flex-wrap items-center gap-3">
              <a class="btn btn-primary" href="#projetos">Ver projetos</a>
              {
                hasCv && (
                  <a class="btn" href={cvHref} download>
                    Baixar CV
                  </a>
                )
              }
              <a class="btn btn-box" href={profile.contact.github} rel="me noopener">
                <span aria-hidden="true">↗</span>
                {githubLabel}
              </a>
              <a class="btn btn-box" href={profile.contact.linkedin} rel="me noopener">
                <span aria-hidden="true">↗</span>
                {linkedinLabel}
              </a>
            </div>

            <p class="text-sm text-text-muted">{profile.location}</p>
          </div>

          {
            photo && (
              <Image
                class="hero-photo"
                src={photo}
                alt="Foto de Igor Hermann Salgado"
                width={144}
                height={144}
                densities={[1, 2]}
                fit="cover"
                loading="eager"
                fetchpriority="high"
              />
            )
          }
        </div>
      </section>

      {/* SOBRE */}
      <section id="sobre" aria-labelledby="sobre-title" class={section}>
        <div class="grid gap-4">
          <SectionHeading id="sobre-title" command="cat sobre.md" title="Sobre" />
          <p class="max-w-measure">{profile.about}</p>
        </div>
      </section>

      {/* PROJETOS */}
      <section id="projetos" aria-labelledby="projetos-title" class={section}>
        <div class="grid gap-4">
          <SectionHeading id="projetos-title" command="ls ./projetos" title="Projetos" />
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      </section>

      {/* EXPERIÊNCIA + FORMAÇÃO */}
      <section id="experiencia" aria-labelledby="experiencia-title" class={section}>
        <div class="grid gap-4">
          <SectionHeading id="experiencia-title" command="cat experiencia.md" title="Experiência" />

          {
            profile.experience.map((job) => (
              <article class="grid gap-3 border-l-2 border-border pl-4">
                <div>
                  <h3 class="text-lg font-semibold text-text">{job.role}</h3>
                  <p class="font-mono text-sm text-text-muted">
                    {job.company} · {job.period}
                  </p>
                </div>
                <ul class="m-0 grid max-w-list list-disc gap-2 pl-[1.1rem]">
                  {job.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }

          <div class="grid gap-1 border-t border-dashed border-border pt-4">
            <h3 class="font-mono text-xs font-normal tracking-[0.08em] text-text-muted uppercase">
              Formação
            </h3>
            {
              profile.education.map((edu) => (
                <p>
                  {edu.course} — {edu.institution}
                  {edu.detail && <span> · {edu.detail}</span>}
                </p>
              ))
            }
          </div>
        </div>
      </section>

      {/* STACK */}
      <section id="stack" aria-labelledby="stack-title" class={section}>
        <div class="grid gap-4">
          <SectionHeading id="stack-title" command="stack --list" title="Stack" />
          <dl class="stack-list">
            {
              profile.stack.map((group) => (
                <>
                  <dt class="font-mono text-sm text-text-muted">{group.label}</dt>
                  <dd class="m-0">
                    <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                      {group.items.map((item) => (
                        <li class:list={['chip', { 'chip-secondary': group.secondary }]}>{item}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              ))
            }
          </dl>
        </div>
      </section>

      {/* CONTATO */}
      <section id="contato" aria-labelledby="contato-title" class={section}>
        <div class="grid gap-4">
          <SectionHeading id="contato-title" command="contato" title="Contato" />
          <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 font-mono text-sm">
            <li>
              <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
            </li>
            <li>
              <a href={profile.contact.linkedin} rel="me noopener">{linkedinLabel}</a>
            </li>
            <li>
              <a href={profile.contact.github} rel="me noopener">{githubLabel}</a>
            </li>
            {
              hasCv && (
                <li>
                  <a href={cvHref} download>
                    Baixar CV (PDF)
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </section>
    </main>

    <footer
      class="band band-tight flex flex-wrap justify-between gap-3 border-t border-border font-mono text-xs text-text-muted"
    >
      <span>© {year} {profile.name} · feito com Astro</span>
      <a href="#inicio" class="text-text-muted hover:text-text">↑ topo</a>
    </footer>
  </div>
</Layout>
